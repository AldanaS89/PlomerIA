%% Máquina de estados de una Solicitud - PlomerIA
stateDiagram-v2
    [*] --> PENDIENTE : cliente crea la solicitud
    PENDIENTE --> EN_PROGRESO : un profesional acepta
    PENDIENTE --> PENDIENTE : reasignar (otros 5, máx 3 rondas)
    PENDIENTE --> SIN_RESPUESTA : nadie acepta tras 3 rondas
    PENDIENTE --> CANCELADA : cliente cancela

    EN_PROGRESO --> EN_CAMINO : plomero marca en camino
    EN_PROGRESO --> REASIGNACION_PENDIENTE : el plomero cancela
    EN_PROGRESO --> CANCELADA : cliente cancela (con penalización)

    EN_CAMINO --> PENDIENTE_CALIFICACION : plomero finaliza
    EN_CAMINO --> REASIGNACION_PENDIENTE : el plomero cancela
    EN_CAMINO --> CANCELADA : cliente cancela (con penalización)

    REASIGNACION_PENDIENTE --> PENDIENTE : cliente vuelve a solicitar
    REASIGNACION_PENDIENTE --> CANCELADA : cliente cancela

    PENDIENTE_CALIFICACION --> COMPLETADA : ambos califican (o 72 h -> 5★ auto)

    SIN_RESPUESTA --> [*]
    CANCELADA --> [*]
    COMPLETADA --> [*]
